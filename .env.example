# Copy to .env.local (ignored by git) or run `eas env:pull --environment development`.
# The real values live in EAS: `eas env:create --environment <env> --name <NAME> --value <value>`.

# OTLP collector base URL; the app adds /v1/traces.
EXPO_PUBLIC_OTLP_ENDPOINT=https://otlp.sincpro.dev
# Ingest-only key, sent as the `apikey` header. Never commit it.
EXPO_PUBLIC_OTLP_API_KEY=
# production | preview | development — the traces' deployment.environment.
EXPO_PUBLIC_APP_ENV=development
# GlitchTip project's DSN (Sentry protocol): unexpected failures only. Never commit it.
EXPO_PUBLIC_SENTRY_DSN=
