# The variables the app reads. Copy this file and fill it; the copies never go to git:
#   .env               the deploy's values (production). `eas build` uploads it (.easignore) and
#                      `eas update` reads it on this machine.
#   .env.development   the developer's: `expo start` and `make android` read it over .env.
# A variable created in EAS (`eas env:create`) wins over these files.

# OTLP collector base URL; the app adds /v1/traces.
EXPO_PUBLIC_OTLP_ENDPOINT=https://otlp.sincpro.dev
# Loki's base URL; the app adds /loki/api/v1/push. The OTLP collector takes no logs.
EXPO_PUBLIC_LOKI_ENDPOINT=https://loki.sincpro.dev
# The telemetry key OTLP and Loki accept, sent as the `apikey` header. Never commit it.
EXPO_PUBLIC_OTLP_API_KEY=
# production | preview | development — the traces' deployment.environment.
EXPO_PUBLIC_APP_ENV=production
# GlitchTip project's DSN (Sentry protocol): unexpected failures only. Never commit it.
EXPO_PUBLIC_SENTRY_DSN=
