{
  "expo": {
    "name": "Tickets",
    "slug": "sincpro-mobile-tickets",
    "owner": "sincpro",
    "scheme": "bo.com.sincpro.mobile.tickets",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/TICKETS/icon.png",
    "android": {
      "package": "bo.com.sincpro.tickets",
      "adaptiveIcon": {
        "foregroundImage": "./assets/TICKETS/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/TICKETS/adaptive-icon-monochrome.png",
        "backgroundColor": "#0B0A09"
      }
    },
    "ios": {
      "bundleIdentifier": "bo.com.sincpro.tickets",
      "icon": {
        "light": "./assets/TICKETS/icon.png",
        "dark": "./assets/TICKETS/icon-dark.png",
        "tinted": "./assets/TICKETS/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/TICKETS/favicon.png"
    },
    "plugins": [
      "./plugins/withPrefabOrder",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/TICKETS/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0B0A09",
          "dark": {
            "image": "./assets/TICKETS/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-background-task",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "@sincpro/printer-expo",
        {
          "bluetoothClassic": true,
          "bluetoothUsageDescription": "Se usa Bluetooth para conectar la impresora de tickets."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { void <init>(); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ed2d124-85d4-4a63-a20b-45b9aa87fc71"
      }
    }
  }
}
