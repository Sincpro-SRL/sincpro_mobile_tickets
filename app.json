{
  "expo": {
    "name": "Tickets",
    "slug": "sincpro-mobile-tickets",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/TICKETS/icon.png",
    "android": {
      "package": "bo.com.sincpro.tickets",
      "adaptiveIcon": {
        "foregroundImage": "./assets/TICKETS/adaptive-icon-foreground.png",
        "backgroundColor": "#0EA5E9"
      }
    },
    "ios": {
      "bundleIdentifier": "bo.com.sincpro.tickets"
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/TICKETS/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0EA5E9",
          "dark": {
            "image": "./assets/TICKETS/splash.png",
            "backgroundColor": "#0C4A6E"
          }
        }
      ],
      "expo-background-task",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "@sincpro/printer-expo",
        {
          "bluetoothClassic": true,
          "bluetoothUsageDescription": "Se usa Bluetooth para conectar la impresora de tickets."
        }
      ]
    ]
  }
}
